# For the throwaway e2e Compose project (sbw-e2e) only. Copied to .env.e2e (untracked,
# gitignored) by scripts/e2e.sh. Nothing here is a secret and nothing here is used by the real stack.

# Compose project name; scripts/e2e.sh refuses anything but sbw-e2e.
COMPOSE_PROJECT_NAME=sbw-e2e
# Host path of the e2e vault copy, mounted at /vault. Must be under /mnt/d/sbw-e2e/ and never the real vault.
VAULT_PATH=/mnt/d/sbw-e2e/vault
# Time zone for containers and Django.
TZ=Asia/Manila
# Django signing key. Clearly not a secret; at least 50 characters as settings.py requires.
DJANGO_SECRET_KEY=e2e-only-not-a-secret-e2e-only-not-a-secret-e2e-only-not-a-secret-
# Keep false.
DJANGO_DEBUG=false
# Comma-separated hostnames Django will serve.
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# Comma-separated origins (with scheme) allowed for CSRF-protected requests; the e2e frontend port is 5174.
CSRF_TRUSTED_ORIGINS=http://localhost:5174,http://127.0.0.1:5174
# Database name, role and password for the e2e project's own database.
POSTGRES_DB=second_brain_e2e
POSTGRES_USER=second_brain
POSTGRES_PASSWORD=e2e-only-not-a-secret
# Seconds between indexer polls of the vault.
INDEXER_POLL_SECONDS=10
# Host ports, bound to 127.0.0.1 only; different from the real stack's 8000 and 5173.
BACKEND_PORT=8001
FRONTEND_PORT=5174
# Test clock: both must be set for the pinned date to apply (plan section 2.12). Golden-vault mode only;
# e2e.sh up --vault-copy-of removes both so the copy is checked at the real date.
SECOND_BRAIN_TEST_MODE=1
SECOND_BRAIN_TODAY=2026-10-09
