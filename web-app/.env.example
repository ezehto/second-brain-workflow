# Copy to web-app/.env (untracked, gitignored) and edit. Never commit .env.
# No app user credentials belong here: the single dashboard user is created
# with `manage.py createsuperuser` and stored only in the database (decision C18).

# Host path of the real vault, mounted at /vault. The path contains a space; Compose mounts are quoted.
VAULT_PATH="/mnt/d/Second Brain"
# Time zone for containers and Django.
TZ=Asia/Manila
# Django signing key. Placeholder only: generate a long random value in .env.
DJANGO_SECRET_KEY=change-me-not-a-secret
# Keep false outside throwaway local debugging.
DJANGO_DEBUG=false
# Comma-separated hostnames Django will serve.
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# Comma-separated origins (with scheme) allowed for CSRF-protected requests.
CSRF_TRUSTED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Database name, role and password. Placeholder password: set your own in .env.
POSTGRES_DB=second_brain
POSTGRES_USER=second_brain
POSTGRES_PASSWORD=change-me-not-a-secret
# Seconds between indexer polls of the vault.
INDEXER_POLL_SECONDS=10
# Host ports, bound to 127.0.0.1 only.
BACKEND_PORT=8000
FRONTEND_PORT=5173
# Dashboard data source: `http` (the real API through the dev proxy) or `mock` (sample data, no backend).
VITE_API_MODE=http
